// Data model: spec §3. Extra constraints Prisma cannot express (CHECKs, lower(username) index)
// live in the migration SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  USER
}

enum TransactionType {
  IN
  OUT
}

enum MaterialStatus {
  ACTIVE
  INACTIVE
}

/// Spec v2.2 D9: total count only, or one row per serial number.
enum TrackingType {
  QUANTITY
  SERIAL
}

enum UnitStatus {
  IN_STOCK
  ISSUED
  /// Came from a receipt that was later reversed.
  VOID
}

/// MAIN can be the requesting or the using department; SUB only the using one (D11).
enum DepartmentKind {
  MAIN
  SUB
}

model User {
  id                String             @id @default(uuid())
  /// Login name. Unique case-insensitively via the users_username_lower_key index.
  username          String             @unique
  passwordHash      String             @map("password_hash")
  fullName          String             @map("full_name")
  role              Role               @default(USER)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  stockTransactions StockTransaction[]
  requests          StockTransaction[] @relation("Requester")

  @@map("users")
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  materials   Material[]
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("categories")
}

model Material {
  id                String                 @id @default(uuid())
  code              String                 @unique
  name              String
  categoryId        String                 @map("category_id")
  category          Category               @relation(fields: [categoryId], references: [id])
  unit              String
  currentQuantity   Int                    @default(0) @map("current_quantity")
  minStock          Int                    @default(0) @map("min_stock")
  brand             String?
  model             String?
  trackingType      TrackingType           @default(QUANTITY) @map("tracking_type")
  storageLocationId String?                @map("storage_location_id")
  storageLocation   StorageLocation?       @relation(fields: [storageLocationId], references: [id])
  status            MaterialStatus         @default(ACTIVE)
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  transactionItems  StockTransactionItem[]
  units             MaterialUnit[]

  @@index([categoryId])
  @@index([status])
  @@map("materials")
}

model StockTransaction {
  id           String                 @id @default(uuid())
  type         TransactionType
  referenceNo  String                 @unique @map("reference_no")
  createdById  String                 @map("created_by_id")
  createdBy    User                   @relation(fields: [createdById], references: [id])
  note         String?
  reversalOfId String?                @unique @map("reversal_of_id")
  reversalOf   StockTransaction?      @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy   StockTransaction?      @relation("Reversal")
  createdAt    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  items        StockTransactionItem[]
  units        TransactionUnit[]

  // Receipt (IN)
  fiscalYear  Int?    @map("fiscal_year") /// Thai fiscal year (B.E.), e.g. 2568
  projectName String? @map("project_name") /// procurement project (TOR)

  // Withdrawal (OUT). Departments are nullable only for imported history that could not be matched.
  requesterId            String?     @map("requester_id")
  requester              User?       @relation("Requester", fields: [requesterId], references: [id])
  /// Always stored, so history keeps the name even if the user is renamed or was typed by staff.
  requesterName          String      @map("requester_name")
  requestingDepartmentId String?     @map("requesting_department_id")
  requestingDepartment   Department? @relation("RequestingDepartment", fields: [requestingDepartmentId], references: [id])
  usingDepartmentId      String?     @map("using_department_id")
  usingDepartment        Department? @relation("UsingDepartment", fields: [usingDepartmentId], references: [id])
  buildingId             String?     @map("building_id")
  building               Building?   @relation(fields: [buildingId], references: [id])
  floor                  String?
  /// "ระบบงานที่ใช้"
  purpose                String?

  @@index([type, createdAt])
  @@index([createdById])
  @@map("stock_transactions")
}

model StockTransactionItem {
  id            String           @id @default(uuid())
  transactionId String           @map("transaction_id")
  transaction   StockTransaction @relation(fields: [transactionId], references: [id])
  materialId    String           @map("material_id")
  material      Material         @relation(fields: [materialId], references: [id])
  quantity      Int
  unitPrice     Decimal?         @map("unit_price") @db.Decimal(10, 2)

  @@unique([transactionId, materialId])
  @@index([materialId])
  @@map("stock_transaction_items")
}

model ReferenceCounter {
  /// YYYYMMDD in Asia/Bangkok
  date      String @id
  lastValue Int    @map("last_value")

  @@map("reference_counters")
}

model Department {
  id         String             @id @default(uuid())
  name       String             @unique
  kind       DepartmentKind
  isActive   Boolean            @default(true) @map("is_active")
  requesting StockTransaction[] @relation("RequestingDepartment")
  using      StockTransaction[] @relation("UsingDepartment")

  @@map("departments")
}

model Building {
  id           String             @id @default(uuid())
  name         String             @unique
  isActive     Boolean            @default(true) @map("is_active")
  transactions StockTransaction[]

  @@map("buildings")
}

model StorageLocation {
  id        String         @id @default(uuid())
  name      String         @unique
  isActive  Boolean        @default(true) @map("is_active")
  materials Material[]
  units     MaterialUnit[]

  @@map("storage_locations")
}

/// One physical item of a SERIAL material. For those materials currentQuantity always equals
/// the number of IN_STOCK units (kept in sync inside the same DB transaction).
model MaterialUnit {
  id                String            @id @default(uuid())
  materialId        String            @map("material_id")
  material          Material          @relation(fields: [materialId], references: [id])
  /// Unique case-insensitively via the material_units_serial_lower_key index.
  serialNumber      String            @map("serial_number")
  /// Placeholder created by the import (…-TEMP-SN-NN); an admin replaces it with the real one.
  isTempSerial      Boolean           @default(false) @map("is_temp_serial")
  status            UnitStatus        @default(IN_STOCK)
  storageLocationId String?           @map("storage_location_id")
  storageLocation   StorageLocation?  @relation(fields: [storageLocationId], references: [id])
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)
  movements         TransactionUnit[]

  @@index([materialId, status])
  @@index([isTempSerial])
  @@map("material_units")
}

/// Which units moved in which transaction.
model TransactionUnit {
  transactionId String           @map("transaction_id")
  transaction   StockTransaction @relation(fields: [transactionId], references: [id])
  unitId        String           @map("unit_id")
  unit          MaterialUnit     @relation(fields: [unitId], references: [id])
  /// Per-unit note, e.g. the device it was installed in ("VJRNB0300").
  remark        String?

  @@id([transactionId, unitId])
  @@index([unitId])
  @@map("transaction_units")
}
